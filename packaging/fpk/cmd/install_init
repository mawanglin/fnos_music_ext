#!/bin/bash
# Fast prechecks before the package files are laid down; install.sh re-checks
# everything with detailed messages, so keep this to the hard prerequisites (native-only: no Docker needed).

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

command -v python3 >/dev/null 2>&1 || fnmusic_fail "未检测到 python3：原生部署需要 Python 3.11+（可在应用中心安装 python312）"
[ -S /var/run/trim_music.socket ] || [ -S /var/run/trim_music_upstream.socket ] || fnmusic_fail "未检测到官方\"飞牛音乐\"：请先在应用中心安装并启动飞牛音乐"

exit 0
