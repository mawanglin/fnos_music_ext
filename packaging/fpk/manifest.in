appname               = fnmusic-ext
version               = @VERSION@
display_name          = fnMusic 音源扩展（原生版）
desc                  = 飞牛音乐第三方音源扩展（原生部署，无需 Docker，基于 javycoder/fnos_music_ext）：零侵入接管官方音乐入口，提供 musicdl 聚合、网易云、洛雪自定义源在线搜索播放，内置管理页（音源切换/扫码登录/平台选择/边听边存）。
platform              = @PLATFORM@
source                = thirdparty
maintainer            = mawanglin
maintainer_url        = https://github.com/mawanglin/fnos_music_ext
os_min_version        = 1.2.0
install_dep_apps      = trim.music
desktop_uidir         = ui
desktop_applaunchname = fnmusic-ext.main
checkport             = false
micro_app             = true
